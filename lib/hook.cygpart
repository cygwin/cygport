declare -a __hooks

__hook_add() {
	__hooks+=($1)
}

__hooks_run() {
	# run internal hooks
	for hook in "${__hooks[@]}"
	do
		if ! $hook $1
		then
			# internal hooks should error, but if we forget...
			error "cygport $1 stopped by $hook"
		fi
	done

#****v* Preparation/src_hook
#  DESCRIPTION

#  src_hook() is an optional function which can be defined to perform additional
#  checks on the environment, or manipulate files before a cygport command is
#  run.
#
#  It receives the cygport sub-command as an argument ('download', 'prep',
#  'compile', 'test', 'install', 'package' or 'upload'). Calling error, or
#  returning a non-zero result causes the subcommand to stop with an error.
#
#  (This API is not yet stable and is subject to change)
#****

	# run user hook
	if __check_function src_patch_apply_hook
	then
		if ! src_hook $1
		then
			error "cygport $1 stopped by src_check_hook"
		fi
	fi
}

readonly -f __hook_add __hooks_run
